# Postgres connection. Use the DB_* settings (Laravel Forge fills these in for you),
# or a single DATABASE_URL, which takes precedence when set.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=appcentral
DB_USERNAME=appcentral
DB_PASSWORD=appcentral
# DATABASE_URL=postgres://appcentral:appcentral@localhost:5433/appcentral

# Public URL of this dashboard (used in report links)
APP_URL=http://localhost:3000

# Shared secret for POST /api/cron/reports (send as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me
